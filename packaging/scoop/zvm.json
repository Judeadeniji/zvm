  "version": "0.1.0",
  "description": "Fast, zero-dependency Zig version manager written in Zig",
  "homepage": "https://github.com/Judeadeniji/zvm",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/Judeadeniji/zvm/releases/download/v0.1.0/zvm-v0.1.0-x86_64-windows.zip",
      "extract_dir": "zvm-v0.1.0-x86_64-windows",
